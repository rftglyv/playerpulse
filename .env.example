# ── PlayerPulse environment ─────────────────────────────────────────────
# Local dev: copy to .env. Dokploy: paste these into the Compose app's
# "Environment" tab (docker-compose.yml reads them).

# Postgres, hosted separately (required). The api runs migrations on boot
# and loads the demo runs into an empty database.
# From inside Docker, use the DB host as the containers see it
# (e.g. the Dokploy Postgres service name, or host.docker.internal for a DB on the host).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/playerpulse

# OpenRouter key (optional). Without it the demo results still load;
# only "New run" (live AI runs) is disabled.
OPENROUTER_API_KEY=

# Default model for live runs (optional).
# Options: anthropic/claude-sonnet-5.5 | anthropic/claude-haiku-5.5 | google/gemini-3.8-flash | openai/gpt-5.6-luna
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Host port the web app is published on (optional, default 3000).
# In Dokploy you can instead attach a domain to the "web" service on port 3000.
WEB_PORT=3000
