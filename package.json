{
  "name": "playerpulse",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "bun test",
    "db:push": "bun --filter @playerpulse/db db:push",
    "pipeline": "bun --env-file=.env packages/pipeline/src/cli.ts",
    "eval": "python3 eval/evaluate.py",
    "check-types": "turbo run check-types",
    "db:seed": "bun --filter @playerpulse/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.8.9",
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.12"
  }
}